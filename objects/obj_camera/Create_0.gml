// Câmera usada pelo Viewport 0
camera_id = view_camera[0];

// Tamanho interno da câmera
camera_largura = 640;
camera_altura = 360;

// Posição horizontal do player na tela
// 0.40 = aproximadamente 40% da tela
posicao_player_tela = 0.40;

// Quanto menor, mais suave
suavidade = 0.10;

// Posição inicial
camera_x = 0;
camera_y = 0;